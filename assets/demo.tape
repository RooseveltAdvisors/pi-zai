Output "assets/pi-zai-demo.gif"
Set FontFamily "JetBrains Mono"
Set FontSize 24
Set Width 1200
Set Height 520
Set Padding 24
Set Theme {"名称":"Pi Z.AI","background":"#101827","foreground":"#dbeafe","purple":"#a78bfa","green":"#86efac","cyan":"#67e8f9","black":"#101827","red":"#fca5a5","yellow":"#fde68a","blue":"#93c5fd","magenta":"#f0abfc","white":"#f8fafc"}
Set TypingSpeed 18ms
Type "bash assets/demo-output.sh" Sleep 300ms Enter
Sleep 3s
